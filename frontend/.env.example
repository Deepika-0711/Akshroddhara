# =======================================================
# Aksharoddhaara (ಅಕ್ಷರೋದ್ಧಾರ) — Frontend Environment Configuration
# =======================================================
#
# Production Backend URL (Live Render Backend):
# Set this environment variable in your Vercel Project Settings:
# Settings -> Environment Variables -> VITE_API_URL
#
# Example production URL:
VITE_API_URL=https://akshroddhara.onrender.com

# In local development:
# If VITE_API_URL is left unset, frontend API requests will default to '/api'
# and will be proxied to http://localhost:5000 by the Vite development server.
