# =======================================================
# Aksharoddhaara (ಅಕ್ಷರೋದ್ಧಾರ) — Environment Configuration
# =======================================================
# Place this configuration in backend/.env

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10

# AI Provider Configuration (Step 4 - Text Recovery Suggestions)
# Supported providers: Google Gemini (recommended) or OpenAI
# Free tier key obtainable from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
